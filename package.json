{
  "name": "commander-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "local-start": "bash ./scripts/start-dev.sh",
    "local-stop": "bash ./scripts/stop-dev.sh"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "vite": "^8.3.5"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "next": "16.4.2",
    "sharp": ">=0.35.4",
    "js-yaml": "^4.3.2",
    "zod": "^4.6.7",
    "undici": "^7.30.1",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.12"
    }
  }
}
